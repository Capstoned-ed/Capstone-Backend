SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
THROTTLE_ANON_RATE=100/minute
THROTTLE_USER_RATE=1000/minute
ML_SERVICE_URL=http://localhost:8001
